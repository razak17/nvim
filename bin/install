#!/bin/bash

RV_CONFIG_DIR="${RV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rvim}"
RV_DATA_DIR="${RV_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/rvim}"

asktoinstallgit() {
  echo "git not found, please install git" && exit
}

asktoinstallnode() {
  echo "Please install node before continuing with install" && exit
}

moveoldrvim() {
  echo "rvim not installed"
  echo "Please remove '$RV_CONFIG_DIR' path before installing" && exit
}

createDirs() {
  mkdir -p "$HOME/.dots"
  mkdir -p "$HOME/.cache/rvim"
  mkdir -p "$HOME/.cache/rvim/undodir"
  mkdir -p "$HOME/.local/share/rvim"
  mkdir -p "$HOME/.local/share/rvim/site"
  mkdir -p "$HOME/.local/share/rvim/site/spell"
  mkdir -p "$HOME/.local/share/rvim/site/prompts"
}

setup_venv() {
  local pkg_manager="${1:-pip}"
  local python_cmd

  if [ -x "$RV_DATA_DIR/venv/bin/python3" ]; then
    return 0
  fi

  if [ "$pkg_manager" = "uv" ]; then
    uv venv "$RV_DATA_DIR/venv"
  else
    if command -v python3 >/dev/null 2>&1; then
      python_cmd=python3
    elif command -v python >/dev/null 2>&1; then
      python_cmd=python
    else
      echo "Python not found. Please install Python 3 with venv support." >&2
      return 1
    fi
    "$python_cmd" -m venv "$RV_DATA_DIR/venv"
  fi
}

install_py_deps() {
  local pkg_manager
  local venv_python="$RV_DATA_DIR/venv/bin/python3"
  local packages=(setuptools neovim-remote python-dotenv requests pynvim prompt-toolkit)

  printf "Which package manager would you like to use (pip, uv)? "
  if ! read -r pkg_manager; then
    echo "No package manager selected." >&2
    return 1
  fi

  case "$pkg_manager" in
  pip) ;;
  uv)
    if ! command -v uv >/dev/null 2>&1; then
      echo "[uv] not found. Please install it and add it to PATH." >&2
      return 1
    fi
    ;;
  *)
    echo "Unknown package manager: $pkg_manager" >&2
    return 1
    ;;
  esac

  setup_venv "$pkg_manager" || return $?
  echo "Installing Python dependencies with $pkg_manager"
  if [ "$pkg_manager" = "uv" ]; then
    uv pip install --python "$venv_python" -U "${packages[@]}"
  else
    # Environments created by uv may not contain pip.
    if ! "$venv_python" -m pip --version >/dev/null 2>&1; then
      "$venv_python" -m ensurepip --upgrade || return $?
    fi
    "$venv_python" -m pip install -U "${packages[@]}"
  fi
}

install_js_packages() {
  local pkg_manager="$1"
  local packages=(tree-sitter-cli neovim five-server)

  case "$pkg_manager" in
  npm | pnpm) "$pkg_manager" install -g "${packages[@]}" ;;
  yarn) yarn global add "${packages[@]}" ;;
  bun) bun add -g "${packages[@]}" ;;
  esac
}

archExtra() {
  sudo pacman -S ripgrep xsel fd lazygit unzip curl sqlite3 btop glow curl ueberzugpp freeze
}

rocks() {
  luarocks --local --lua-version=5.1 install magick
}

importRvim() {
  echo "Cloning rVim configuration"
  git clone "https://github.com/razak17/nvim" "$RV_CONFIG_DIR"
}

install_js_deps() {
  local pkg_manager
  printf "Which package manager would you like to use (pnpm, yarn, npm, bun)? "
  if ! read -r pkg_manager; then
    echo "No package manager selected." >&2
    return 1
  fi

  case "$pkg_manager" in
  npm | pnpm | yarn | bun) ;;
  *)
    echo "Unknown package manager: $pkg_manager" >&2
    return 1
    ;;
  esac

  if ! command -v "$pkg_manager" >/dev/null 2>&1; then
    echo "[$pkg_manager] not found. Please install it and add it to PATH." >&2
    return 1
  fi

  echo "Installing JavaScript dependencies with $pkg_manager"
  install_js_packages "$pkg_manager"
}

generate_dict() {
  dicwords="$RV_DATA_DIR/site/spell/en.dict"
  if [ ! -x "$(command -v aspell)" ]; then
    echo "aspell not found, please install aspell and aspell-en" && exit
  fi
  if [ -e "$dicwords" ]; then
    echo "en.dict already exists, skipping..." && exit
  fi
  echo 'Generating en.dict...'
  aspell -d en dump master | aspell -l en expand >"$dicwords"
  echo "done."
}

install_deps() {
  printf "Would you like to install JavaScript packages now (y/n)? "
  read -r answer
  if [[ "$answer" = [Yy]* ]]; then
    install_js_deps || return $?
  fi

  printf "Would you like to install extra arch packages now (y/n)? "
  read -r answer
  if [[ "$answer" = [Yy]* ]]; then
    archExtra
  fi

  printf "Would you like to install luarocks packages now (y/n)? "
  read -r answer
  if [[ "$answer" = [Yy]* ]]; then
    rocks
  fi

  printf "Would you like to install Python packages now (y/n)? "
  read -r answer
  if [[ "$answer" = [Yy]* ]]; then
    install_py_deps
  fi
}

clone_config() {
  (command -v git >/dev/null && echo "git installed, moving on...") || asktoinstallgit

  # check existing config
  [ -d "$RV_CONFIG_DIR" ] && moveoldrvim

  echo "Creating default directories"
  createDirs

  echo "Installing rvim"
  importRvim

  [ -e "$HOME/.local/bin/rvim" ] && rm "$HOME/.local/bin/rvim"

  ln -s "$RV_CONFIG_DIR/bin/rvim" "$HOME/.local/bin/rvim"
}

while [ "$#" -gt 0 ]; do
  curr=$1
  shift

  case "$curr" in
  -venv) setup_venv || exit $? ;;
  --py-deps | -py) install_py_deps || exit $? ;;
  --js-deps | -npm) install_js_deps || exit $? ;;
  -deps) install_deps || exit $? ;;
  -dict) generate_dict ;;
  -rocks) rocks ;;
  *--all*)
    clone_config
    install_deps || exit $?
    generate_dict
    ;;
  *) echo "Unavailable command... $curr" ;;
  esac
done
